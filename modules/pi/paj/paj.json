{
  "subagents": {
    "model": {
      "rules": [
        { "parentFamily": "astra", "childFamily": "sol" },
        { "parentFamily": "fable", "childFamily": "opus" }
      ],
      "provider": "same",
      "version": "latest",
      "fallback": "inherit"
    }
  },
  "captain": {
    "version": 1,
    "workspaces": {
      "allow": ["~/Development/**", "~/.nixos"],
      "exclude": []
    },
    "reporting": {
      "progress": false,
      "verbosity": "brief"
    }
  },
  "voice": {
    "voice": "ljspeech",
    "maxMessageSeconds": 20
  }
}
