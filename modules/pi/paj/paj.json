{
  "projects": { "roots": ["~/Development/**"] },
  "subagents": {
    "model": {
      "rules": [
        { "parentFamily": "astra", "childFamily": "sol" },
        { "parentFamily": "fable", "childFamily": "opus" }
      ],
      "provider": "same",
      "version": "latest",
      "fallback": "inherit"
    }
  },
  "captain": {
    "version": 1,
    "workspaces": {
      "allow": ["~/Development/**", "~/.nixos"],
      "exclude": []
    },
    "reporting": {
      "progress": false,
      "verbosity": "brief"
    }
  },
  "voice": {
    "voice": "amy",
    "volume": 30,
    "speed": 1.2,
    "pauseSeconds": 1.5,
    "maxMessageSeconds": 120,
    "feedback": {
      "receipt": "Heard",
      "steeringReceipt": "Steering",
      "progressUpdates": true,
      "idleReminders": false
    },
    "audioDucking": {
      "enabled": true,
      "gain": 0.1,
      "ignoreApps": []
    }
  }
}
